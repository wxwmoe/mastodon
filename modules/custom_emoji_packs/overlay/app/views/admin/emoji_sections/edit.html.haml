- content_for :page_title do
  = t('wxw_emoji.admin.sections.edit')

- content_for :heading_actions do
  = link_to t('auth.rules.back'), admin_emoji_sections_path, class: 'button'

= simple_form_for @section, url: admin_emoji_section_path(@section) do |form|
  = render 'shared/error_messages', object: @section

  = render 'form', form: form

  .actions
    = form.button :button, t('generic.save_changes'), type: :submit
