- content_for :page_title do
  = t('wxw_emoji.admin.packs.set_section')

- content_for :heading_actions do
  = link_to t('auth.rules.back'), admin_emoji_packs_path, class: 'button'

= simple_form_for :emoji_packs, url: update_group_admin_emoji_packs_path, method: :patch do |form|
  - @packs.each do |pack|
    = render 'shared/error_messages', object: pack if pack.errors.any?

  - @pack_ids.each do |id|
    = hidden_field_tag 'emoji_packs[ids][]', id

  %p.hint= t('wxw_emoji.admin.packs.selected_count', count: @pack_ids.size)

  .fields-group
    = form.input :section_id,
                 collection: @sections,
                 include_blank: t('wxw_emoji.no_section'),
                 label: t('wxw_emoji.admin.packs.set_section'),
                 label_method: ->(section) { section.name_for(I18n.locale) },
                 required: false,
                 wrapper: :with_block_label

  .actions
    = form.button :button, t('generic.save_changes'), type: :submit
