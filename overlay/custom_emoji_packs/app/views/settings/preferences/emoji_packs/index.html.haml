- content_for :page_title do
  = t('wxw_emoji.title')

- content_for :heading_actions do
  = link_to t('admin.accounts.search'), search_settings_preferences_emoji_packs_path, class: 'button'

= form_with model: current_user, url: settings_preferences_emoji_packs_path do |form|
  = render 'shared/error_messages', object: current_user

  %p.hint.wxw-emoji-pack-list__hint= t('wxw_emoji.preferences.packs_hint')

  = hidden_field_tag 'user[emoji_ids][]', ''

  .batch-table
    .batch-table__toolbar
      %label.batch-table__toolbar__select.batch-checkbox-all
        = check_box_tag :batch_checkbox_all, nil, false
      .batch-table__toolbar__actions
        = form.button safe_join([material_symbol('save'), t('generic.save_changes')]), name: :save_order, class: 'table-action-link', type: :submit
        = form.button safe_join([material_symbol('refresh'), t('wxw_emoji.preferences.reset')]), name: :reset, class: 'table-action-link', type: :submit

        - numbered_icon = @numbered ? 'radio_button_unchecked' : 'radio_button_checked'
        - numbered_action = @numbered ? t('wxw_emoji.preferences.unnumbered_action') : t('wxw_emoji.preferences.numbered_action')
        = form.button safe_join([material_symbol(numbered_icon), numbered_action]), name: :numbered, class: 'table-action-link', type: :submit

        = form.button safe_join([material_symbol('visibility'), t('wxw_emoji.preferences.show')]), name: :enable, class: 'table-action-link', type: :submit
        = form.button safe_join([material_symbol('visibility_off'), t('wxw_emoji.preferences.hide')]), name: :disable, class: 'table-action-link', type: :submit

    - if @packs.empty?
      .batch-table__body
        = nothing_here 'nothing-here--under-tabs'
    - else
      .batch-table__body.wxw-sortable{ data: { wxw_sortable: true } }
        - @packs.each do |pack|
          - picker_index = @picker_positions[pack.id]
          - icon_emoji = @pack_icons[pack.id]
          - pack_name = pack.name_for(I18n.locale)
          - pack_label = @numbered && picker_index ? "#{format('%0*d.', @number_width, picker_index + 1)} #{pack_name}" : pack_name
          - section_label = pack.section&.name_for(I18n.locale) || t('wxw_emoji.no_section')
          - status_label = @picked_lookup.key?(pack.id) ? t('wxw_emoji.preferences.show') : t('wxw_emoji.preferences.hide')

          .batch-table__row.wxw-sortable__item{ data: { wxw_sortable_item: true } }
            = hidden_field_tag 'user[emoji_order][]', pack.id
            %label.batch-table__row__select.batch-table__row__select--aligned.batch-checkbox
              = check_box_tag 'user[emoji_ids][]', pack.id, false, id: "user_emoji_ids_#{pack.id}"
            .batch-table__row__content.wxw-emoji-pack-list__content
              = link_to search_settings_preferences_emoji_packs_path(pack_id: pack.id), class: 'wxw-emoji-pack-list__identity' do
                .wxw-custom-emoji-frame.wxw-emoji-pack-list__icon
                  - if icon_emoji
                    = image_tag full_asset_url(icon_emoji.image.url(:static)), class: 'custom-emoji wxw-custom-emoji-image', alt: ":#{icon_emoji.shortcode}:", data: { original: full_asset_url(icon_emoji.image.url), static: full_asset_url(icon_emoji.image.url(:static)) }
                  - else
                    = material_symbol 'mood'
                .wxw-emoji-pack-list__names
                  .wxw-emoji-pack-list__name= pack_label
                  .wxw-emoji-pack-list__section-name= "#{section_label} · #{status_label}"
              .wxw-emoji-pack-list__meta
                .wxw-emoji-pack-list__moves
                  = form.button material_symbol('drag_indicator'), type: :button, class: 'wxw-sortable__handle', title: t('wxw_emoji.reorder_handle'), aria: { label: t('wxw_emoji.reorder_handle') }, data: { wxw_sortable_handle: true }
